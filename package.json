{
  "name": "tripsplit",
  "version": "1.0.0",
  "description": "Offline Group Expense & Settlement Tracker",
  "type": "module",
  "scripts": {
    "test": "node --test tests/domain.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "start": "npx serve -l 8080 .",
    "dev": "wrangler pages dev .",
    "d1:migrate:local": "wrangler d1 migrations apply tripsplit-db --local",
    "d1:migrate:prod": "wrangler d1 migrations apply tripsplit-db --remote"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
